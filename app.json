{
  "expo": {
    "name": "StanzyLive",
    "slug": "StanzyLive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stanzylive",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aryan.stanzylive"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/stanzylive.png"
    },
    "plugins": ["expo-router", "@clerk/expo", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5b49933-bd6c-40bb-83d6-06d7d2baacc8"
      }
    },
    "owner": "aryan2604s-team"
  }
}
